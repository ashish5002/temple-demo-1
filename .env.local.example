# Supabase Credentials (Optional for local mockup, required for production persistence)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Cloudinary Integration (For Admin Gallery Image Uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=demo
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=temple_heritage

# Razorpay Integration (For Donation Payments Prep)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
